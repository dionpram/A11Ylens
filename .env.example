# Optional external Buy Me a Coffee / Stripe Payment Link. Leave blank to hide the payment CTA.
NEXT_PUBLIC_SUPPORT_URL=

# Optional browser path (used on servers with a system Chromium installation).
# CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium

# Safety: keep this false except for isolated, locally controlled development fixtures.
ALLOW_LOCAL_SCANS=false

# PUBLIC FRONTEND (production): connects server-to-server to a separate scanner.
# Configure a private HTTPS scanner origin and the same long shared token as worker.
# SCAN_WORKER_URL=https://scanner.example.com/
# SCAN_WORKER_TOKEN=at-least-32-random-characters

# ISOLATED SCANNER WORKER ONLY: keep this setting off on the public frontend.
# The scanner endpoint checks the token before launching Chromium.
# SCAN_WORKER_ENABLED=true

# If no worker is configured, production keeps scanning disabled by default.
# A public deployment also needs durable rate limits and outbound network filtering.

# OPTIONAL REMOTE LIGHTHOUSE SCAN: Google PageSpeed Insights API.
# Does not launch Chromium on Vercel; URLs are sent to Google.
# Do not turn on until the privacy notice and anti-abuse controls are reviewed.
# PAGESPEED_API_ENABLED=true
# PAGESPEED_API_KEY=optional-server-only-google-key
